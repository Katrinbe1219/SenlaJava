<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status = "WARN">
    <!--КУда писать логи - appenders-->
    <Appenders>
        <!--System_out - стандартный поток, вместо System_err-->
        <Console name="Console" target="System_OUT">
            <!--[%t] имя потока-->
            <!--%-5level уровень логирования, выравнивание по ширине 5 символов-->
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{3-6} - %msg%n"/>
        </Console>
        <!--Можно создать несколько консолей для вывода ошибок и инфомрации-->
    </Appenders>
    <!--Что и на каком уровне-->
    <Loggers>
        <!--корневой логер - применяется ко всем классам-->
        <!--level-минимальныц уровень логирования-->
        <Root level="info">
            <!--ссылка еа аппендер-->
            <AppenderRef ref="Console"/>

        </Root>
    </Loggers>
</Configuration>